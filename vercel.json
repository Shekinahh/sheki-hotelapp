    "APP_URL": "https://shekinah-hotel-book-theta.vercel.app",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-1-eu-west-1.pooler.supabase.com",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.utrnqvfliacsywsymdnf",
    "DB_PASSWORD": "#ShekinahHotel",
    "DB_SSLMODE": "require",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "FILESYSTEM_DISK": "local"
  }
}
